<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Flowpay.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground">@color/wavepay_brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_wavepay_mark</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
        <item name="android:windowBackground">@color/wavepay_brand</item>
        <item name="android:statusBarColor">@color/wavepay_brand</item>
        <item name="android:navigationBarColor">@color/wavepay_brand</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="PaymentSuccessTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground">@color/screen_background</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
